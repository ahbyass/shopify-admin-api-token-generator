{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "arrowParens": "always",
  "singleQuote": true,
  "jsxSingleQuote": false,
  "useTabs": false,
  "bracketSpacing": true,
  "trailingComma": "all",
  "semi": false,
  "sortImports": {
    "groups": [
      "type-import",
      ["value-builtin", "value-external"],
      "type-internal",
      "value-internal",
      ["type-parent", "type-sibling", "type-index"],
      ["value-parent", "value-sibling", "value-index"],
      "unknown"
    ],
    "newlines-between": "always"
  },
  "ignorePatterns": [
    "node_modules",
    ".local",
    "config.local.json",
    ".env*",
    "bun.lock",
    "public/ui.js",
    "public/styles.css"
  ],
  "printWidth": 80,
  "sortPackageJson": {
    "sortScripts": true
  },
  "sortTailwindcss": {
    "stylesheet": "./src/client/tailwind.css",
    "functions": ["cn"],
    "preserveWhitespace": true
  }
}
